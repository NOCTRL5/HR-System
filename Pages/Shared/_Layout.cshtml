<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeViewer.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand fs-4" asp-area="" asp-page="/Index">
                    <i class="bi bi-people-fill me-2"></i>EmployeeViewer
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i> Welcome
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Employees/Index">
                                <i class="bi bi-person-lines-fill me-1"></i> Employee Directory
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <a asp-page="/Employees/Create" class="btn btn-sm btn-primary-gradient px-3 py-2 rounded-pill">
                            <i class="bi bi-plus-lg me-1"></i> Add Employee
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto py-3 bg-dark text-light border-top border-secondary">
        <div class="container text-center fs-7 text-muted">
            <span>&copy; 2026 - EmployeeViewer System • Powered by ADO.NET, SQL Stored Procedures & Functions</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
