@page "{id:int}"
@model EmployeeViewer.Pages.Employees.DetailsModel
@{
    ViewData["Title"] = $"Employee Profile - {Model.Employee.FullName}";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="main-card">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h3 class="fw-bold mb-0">@Model.Employee.FullName</h3>
                        <span class="badge bg-secondary">ID: #@Model.Employee.ID</span>
                        <small class="text-muted ms-2">Fetched via <code>sp_GetEmployeeById</code> & UDF <code>fn_FormatEmployeeName</code></small>
                    </div>
                </div>
                <a asp-page="./Edit" asp-route-id="@Model.Employee.ID" class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1"></i> Edit Profile
                </a>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">First Name</small>
                        <span class="fs-5 text-dark">@Model.Employee.FirstName</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Last Name</small>
                        <span class="fs-5 text-dark">@Model.Employee.LastName</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Email Address</small>
                        <a href="mailto:@Model.Employee.Email" class="fs-5 text-primary text-decoration-none">@Model.Employee.Email</a>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Phone Number</small>
                        <span class="fs-5 text-dark">@(string.IsNullOrEmpty(Model.Employee.Phone) ? "N/A" : Model.Employee.Phone)</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Hire Date</small>
                        <span class="fs-5 text-dark">@Model.Employee.HireDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Salary</small>
                        <span class="fs-5 fw-bold text-success">$@Model.Employee.Salary.ToString("N3")</span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Manager ID</small>
                        <span class="fs-5 text-dark">@(Model.Employee.ManagerID.HasValue ? $"Employee #{Model.Employee.ManagerID}" : "No Direct Manager Assigned")</span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                <a asp-page="./Index" class="btn btn-outline-dark px-4">Back to Directory</a>
            </div>
        </div>
    </div>
</div>
